# Server-Side Secrets (Configure in Vercel Project Settings -> Environment Variables)
# NEVER prefix server secrets with VITE_ so they are never bundled into client JavaScript.
WEB3FORMS_ACCESS_KEY=

# Optional: Comma-separated list of allowed production origins for /api/contact Origin validation
ALLOWED_ORIGIN=https://youssef-elgendy.vercel.app

# Optional: Upstash Redis REST credentials for persistent multi-region Edge rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=